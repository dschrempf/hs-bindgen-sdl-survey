# Pins for the SDL3 macro-support survey. Sourced by run-survey.sh.
#
# The numbers in report/ hold only at these revisions. Change a pin and the
# report becomes a different measurement; re-run and update report/ together.

SDL_URL=https://github.com/libsdl-org/SDL
SDL_SHA=09552d5beed674d6beb057481952244f652bb2c2   # release-3.4.0-1231-g09552d5be

HS_BINDGEN_URL=https://github.com/well-typed/hs-bindgen
HS_BINDGEN_SHA=cf56afb3d922f766b924c75e0a5c0345f5e95960

# Provenance only: macro parsing/typechecking lives in c-expr, but hs-bindgen
# depends on the released c-expr-dsl/c-expr-runtime from Hackage, so the survey
# needs no c-expr checkout. Set CEXPR to one to have its SHA recorded.
CEXPR_URL=https://github.com/well-typed/c-expr
CEXPR_SHA=5bbc29d5a19edd38a501ca74897d6c49ab6284cd   # = c-expr-dsl-0.1.0.1

# Reference toolchain of the recorded run; a mismatch is warned about, not fatal.
REF_CLANG=21.1.8
REF_GHC=9.12.3
REF_CEXPR_DSL=0.1.0.1
